/* Game Boy (SM83) linker script for ld.lld + rrt0 */

ENTRY(_reset)

MEMORY {
    ROM  (rx) : ORIGIN = 0x0000, LENGTH = 0x200000  /* 2MB max (MBC5) */
    WRAM (rw) : ORIGIN = 0xC000, LENGTH = 0x2000
    HRAM (rw) : ORIGIN = 0xFF80, LENGTH = 0x007F
}

SECTIONS {
    /* Pad 0x0000-0x001F */
    .pad 0x0000 : { FILL(0xFF); . = 0x0020; } > ROM

    /* RST vectors */
    _RST20      (0x0020) : { KEEP(*(_RST20)) } > ROM
    _RST28      (0x0028) : { KEEP(*(_RST28)) } > ROM
    _RST30      (0x0030) : { KEEP(*(_RST30)) } > ROM

    /* Interrupt vectors */
    _INT_VBL    (0x0040) : { KEEP(*(_INT_VBL)) } > ROM
    _INT_STAT   (0x0048) : { KEEP(*(_INT_STAT)) } > ROM
    _INT_TIMER  (0x0050) : { KEEP(*(_INT_TIMER)) } > ROM
    _INT_SERIAL (0x0058) : { KEEP(*(_INT_SERIAL)) } > ROM
    _INT_JOYPAD (0x0060) : { KEEP(*(_INT_JOYPAD)) } > ROM

    /* ROM header */
    _ENTRY      (0x0100) : { KEEP(*(_ENTRY)) } > ROM
    _LOGO       (0x0104) : { KEEP(*(_LOGO)) } > ROM
    _TITLE      (0x0134) : { KEEP(*(_TITLE)) } > ROM
    _HEADER     (0x0143) : { KEEP(*(_HEADER)) } > ROM

    /* rrt0 init */
    .text.rrt0 : { KEEP(*(.text.rrt0)) } > ROM

    /* GBDK library HOME code */
    .text.home : { *(.text.home) } > ROM

    /* ROM banking: claim the banked per-function sections into their banks
       BEFORE the resident .text glob below would grab them (the linker assigns
       each input section to the first matching output section, in order). The
       banks use explicit 0x4000 VMA + AT(LMA) so they sit in ROM and do not
       disturb the resident location counter, which we save here and restore on
       the resident .text. gb_banked.ld is generated by gb-bank-pack (empty if no
       banking); lld searches -L paths for INCLUDE files (Makefile passes -L OUT). */
    __resident_lma = .;
    INCLUDE "gb_banked.ld"

    /* Main code and read-only data (resident, bank 0). The explicit AT() pins
       the LMA back to bank 0; without it, the preceding banked sections leave the
       load counter in a high bank and objcopy's binary layout overlaps. */
    .text __resident_lma : AT(__resident_lma) {
        *(.text .text.*)
        *(.rodata .rodata.*)
    } > ROM

    /* Initialized data — LMA right after .text in bank 0, accessible by rrt0 */
    .data 0xC0A0 : AT(LOADADDR(.text) + SIZEOF(.text)) {
        s__DATA = .;
        *(.data .data.*)
        *(.data.initialized)
        e__DATA = .;
    } > WRAM

    l__DATA = e__DATA - s__DATA;
    s__INITIALIZER = LOADADDR(.data);
    l__INITIALIZER = l__DATA;
    s__INITIALIZED = s__DATA;

    /* Uninitialized data */
    .bss (NOLOAD) : {
        __bss_start = .;
        *(.bss .bss.*)
        *(COMMON)
        __bss_end = .;
    } > WRAM
    __bss_size = __bss_end - __bss_start;

    _shadow_OAM = 0xC000;
    .STACK = 0xE000;

    .hram (NOLOAD) : { *(_HRAM) } > HRAM

    /DISCARD/ : {
        *(.comment)
        *(.eh_frame*)
        *(.debug*)
    }
}
